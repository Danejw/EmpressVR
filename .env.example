# Copy to .env.local when integrating services. Keep real secrets server-side.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Published content: configured on a server-capable host only.
# GitHub Pages continues using the checked-in public snapshot.
SUPABASE_URL=https://zxsrixbjsmyzmqywukwa.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# A dedicated public-events calendar for the /community month grid.
GOOGLE_COMMUNITY_CALENDAR_ID=
# Reserved for future private booking/calendar sync; not used in the public grid.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
