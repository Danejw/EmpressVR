# Optional read-only Supabase browser test for the integration preview.
# Publishable keys are designed for public clients; RLS still controls reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GitHub Pages preview path, overridden only for the integration subdirectory.
GITHUB_PAGES_BASE_PATH=/EmpressVR
